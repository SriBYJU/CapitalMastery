rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /users/{uid}/progress/{docId} {
      allow read, create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Authoritative credentials are server-created. Client writes denied.
    match /credentials/{credentialId} {
      allow read: if signedIn() || isAdmin();
      allow write: if false;
    }

    match /publicCredentials/{token} {
      allow read: if true;
      allow write: if false;
    }

    match /adminAudit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
